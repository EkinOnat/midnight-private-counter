{
  "name": "midnight-private-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A privacy-preserving Counter dApp for Level 2 of the Midnight Builder Challenge.",
  "scripts": {
    "compile": "compact compile contracts/counter.compact managed/counter",
    "test": "vitest run",
    "test:contract": "vitest run tests/counter.test.ts",
    "test:frontend": "vitest run tests/frontend",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "tsx src/deploy.ts",
    "network": "tsx src/network.ts",
    "copy:zk": "node scripts/copy-zk-assets.mjs",
    "dev": "npm run copy:zk && vite",
    "build": "npm run copy:zk && tsc --noEmit && vite build",
    "build:sites": "npm run build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "semver": "^7.7.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "smoldot": "npm:@aspect-build/empty@0.0.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
